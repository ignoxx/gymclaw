#!/usr/bin/env bash
# Host-side: connect your read-only personal calendar feed to the running Docker deployment.
#
#   scripts/connect-personal-calendar          # paste the webcal:// link at the prompt
#
# Run from the directory with docker-compose.yaml. The link is read from a hidden prompt
# (never argv or shell history), redirects are resolved on the host, and the link reaches
# the container over stdin. The feed host must be in EGRESS_EXTRA_HOSTS. Safe to re-run.
set -euo pipefail

read -rsp "Paste your personal calendar link (webcal://…): " LINK; echo
LINK="${LINK//[[:space:]]/}"
case "$LINK" in
  webcal://*) URL="https://${LINK#webcal://}" ;;
  https://*) URL="$LINK" ;;
  *) echo "Expected a webcal:// or https:// link" >&2; exit 1 ;;
esac

# Follow iCloud's partition redirect so the allowlisted host is the one GymClaw will hit.
# URL goes through curl's stdin config, not argv.
FINAL="$(printf 'url = "%s"\n' "$URL" | curl -fsSL --proto '=https' --proto-redir '=https' --max-time 60 -o /dev/null -w '%{url_effective}' -K -)" \
  || { echo "Feed not reachable. Is Public Calendar still enabled?" >&2; exit 1; }
HOST="${FINAL#https://}"; HOST="${HOST%%/*}"
echo "Feed host: $HOST"

docker compose exec -T egress grep -qx "$HOST" /tmp/allowed-hosts || {
  echo "Add $HOST to EGRESS_EXTRA_HOSTS, redeploy egress, then re-run." >&2; exit 1; }

printf '%s' "$FINAL" | docker compose exec -T -w /opt/gymclaw gymclaw sh -c \
  'umask 077; f=$(mktemp); cat > "$f"; scripts/gymclaw-tool calendar personal-connect --url-file "$f"; rc=$?; rm -f "$f"; exit $rc'
