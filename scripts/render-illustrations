#!/usr/bin/env bash
# Re-render Telegram PNGs from the bundled Workout Guide SVGs, or only the SVGs given
# (scripts/render-illustrations [svg…]); each PNG is written next to its SVG.
# 1024 px on an opaque dark background, 32-colour palette (line art stays crisp, ~30 KB each).
# Art is drawn at 820 px and centred: the source art runs close to its edges, and Telegram's
# rounded photo corners would otherwise clip it.
# Needs rsvg-convert (librsvg) and ImageMagick: brew install librsvg imagemagick
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)/assets/workout-guide"
[ $# -gt 0 ] || set -- "$ROOT"/*/frame-1.svg
for svg in "$@"; do
  png="${svg%.svg}.png"
  rsvg-convert -w 820 -h 820 -b '#000000' "$svg" | magick - -background '#000000' -gravity center -extent 1024x1024 -colors 32 -strip "PNG8:$png"
done
echo "Rendered $# PNGs"
