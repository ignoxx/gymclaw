# Mirrors the table in docs/self-hosting.md ("Deploy"); defaults live in src/config.rs.
# Required
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Your numeric Telegram user ID (not the bot token): the only user the bot answers.
GYMCLAW_TELEGRAM_USER_ID=

# Optional
TZ=Europe/Berlin
GYMCLAW_MODEL=
GYMCLAW_PROVIDER=
GYMCLAW_MODEL_VISION=
GYMCLAW_MODEL_AUDIO=
GYMCLAW_DASHBOARD_HOST=
EGRESS_EXTRA_HOSTS=
GYMCLAW_IMAGE_TAG=
# Without Docker (the image sets the paths; compose maps TZ to GYMCLAW_TIMEZONE)
# GYMCLAW_TIMEZONE=Europe/Berlin
# GYMCLAW_DATA_DIR=data
# GYMCLAW_DB=data/gymclaw.db
# GYMCLAW_ASSETS_DIR=assets/workout-guide
# GYMCLAW_CROWD_CONFIG=data/crowd-config.json
# GYMCLAW_TURN_LOG_DIR=data/turns
