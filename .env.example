# Required
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# Your numeric Telegram user ID (not the bot token): the only user the bot answers.
GYMCLAW_TELEGRAM_USER_ID=
# Dedicated calendar only; no implicit primary calendar fallback.
GOOGLE_CALENDAR_ID=

# Optional (defaults in docker-compose.yaml)
GYMCLAW_MODEL=
GYMCLAW_MODEL_FAST=
GYMCLAW_MODEL_VISION=
GYMCLAW_PROVIDER=
TZ=Europe/Berlin
# Crowd source lives in data/crowd-config.json, not here (see docs/crowd.md).
