GYMCLAW_TIMEZONE=Europe/Berlin
GYMCLAW_DB_URL=sqlite:///data/gymclaw.db
# Dedicated calendar only; no implicit primary calendar fallback.
GOOGLE_CALENDAR_ID=
# Crowd source lives in data/crowd-config.json, not here (see docs/crowd.md).
# Dedicated OpenClaw profile + verified private Telegram user ID (not bot token).
GYMCLAW_OPENCLAW_PROFILE=gymclaw
GYMCLAW_TELEGRAM_USER_ID=
