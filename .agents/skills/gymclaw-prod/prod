#!/usr/bin/env bash
# Read-mostly access to the GymClaw prod deployment on Coolify, over ssh.
# Resolves the current container on every call; Coolify renames containers on each deploy.
set -euo pipefail

# Host and Coolify app ID stay out of this public repo.
env_file="${GYMCLAW_PROD_ENV:-$HOME/.config/gymclaw/prod.env}"
[ -f "$env_file" ] || { echo "missing $env_file (GYMCLAW_PROD_HOST, GYMCLAW_PROD_APP)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$env_file"
HOST="$GYMCLAW_PROD_HOST"
APP="$GYMCLAW_PROD_APP"
TZ_LOCAL=Europe/Berlin

usage() {
  cat >&2 <<'EOF'
prod ps                          containers, deployed commit, health
prod exec [--dashboard] <cmd…>   run in the gymclaw (or dashboard) container, cwd /opt/gymclaw
prod logs [since=2h]             container logs
prod turns [YYYY-MM-DD] [--all]  Telegram turn timeline from the turn log (UTC date, default today);
                                 heartbeat runs hidden unless --all
prod wait-deploy [sha]           block until prod runs <sha> (default origin/main) and is healthy
prod db-snapshot [out]           consistent read-only copy of the prod DB (default /tmp/gymclaw-prod.db)
EOF
  exit 2
}

container() {  # $1 = service: gymclaw | dashboard
  local name
  name="$(ssh "$HOST" "docker ps --filter name=^$1-$APP- --format '{{.Names}}'" | head -1)"
  [ -n "$name" ] || { echo "no running $1 container for $APP" >&2; exit 1; }
  echo "$name"
}

remote_exec() {  # $1 = container, rest = argv
  local c="$1"; shift
  ssh "$HOST" "docker exec -w /opt/gymclaw $c $(printf '%q ' "$@")"
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  ps)
    ssh "$HOST" "docker ps -a --filter name=-$APP- --format '{{.Names}}\t{{.Image}}\t{{.Status}}'" \
      | sed -E "s/-$APP-[0-9]+//; s/${APP}_[a-z]+://" | column -t -s $'\t'
    ;;
  exec)
    svc=gymclaw; [ "${1:-}" = --dashboard ] && { svc=dashboard; shift; }
    [ $# -gt 0 ] || usage
    remote_exec "$(container $svc)" "$@"
    ;;
  logs)
    ssh "$HOST" "docker logs --since ${1:-2h} $(container gymclaw)" 2>&1
    ;;
  turns)
    day="$(date -u +%F)"; all=0
    for a in "$@"; do case "$a" in --all) all=1 ;; *) day="$a" ;; esac; done
    remote_exec "$(container gymclaw)" cat "data/turns/$day.jsonl" | ALL=$all TZ_LOCAL=$TZ_LOCAL python3 "$(dirname "$0")/turns.py"
    ;;
  wait-deploy)
    sha="${1:-}"
    if [ -z "$sha" ]; then git fetch -q origin main && sha="$(git rev-parse origin/main)"; fi
    for _ in $(seq 60); do
      out="$(ssh "$HOST" "docker ps --filter name=-$APP- --format '{{.Names}} {{.Image}} {{.Status}}'")"
      g="$(grep "^gymclaw-" <<<"$out" || true)"; d="$(grep "^dashboard-" <<<"$out" || true)"
      if grep -q ":$sha" <<<"$g" && grep -q "(healthy)" <<<"$g" && grep -q ":$sha" <<<"$d" && grep -q "(healthy)" <<<"$d"; then
        echo "prod runs ${sha:0:7}, healthy"; exit 0
      fi
      sleep 15
    done
    echo "timed out after 15 min; current:" >&2; echo "$out" >&2; exit 1
    ;;
  db-snapshot)
    out="${1:-/tmp/gymclaw-prod.db}"; c="$(container gymclaw)"; tmp=/tmp/prod-snapshot.db
    # Rust image: `gymclaw backup`; Python image: sqlite3 online backup from a read-only handle.
    ssh "$HOST" "docker exec -w /opt/gymclaw $c sh -c 'rm -f $tmp; if command -v gymclaw >/dev/null; then gymclaw backup $tmp >/dev/null; else python3 -c \"import sqlite3; s=sqlite3.connect(\\\"file:data/gymclaw.db?mode=ro\\\", uri=True); d=sqlite3.connect(\\\"$tmp\\\"); s.backup(d); d.close()\"; fi' && docker exec $c cat $tmp && docker exec $c rm -f $tmp" >"$out"
    echo "$out ($(du -h "$out" | cut -f1))"
    ;;
  *) usage ;;
esac
